generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int               @id @default(autoincrement())
  name           String
  email          String            @unique
  password       String
  createdAt      DateTime          @default(now())
  role           Role              @default(USER)
  updatedAt      DateTime          @updatedAt
  points         Int               @default(0)
  tasksCompleted Int               @default(0)
  achievements   Achievement[]
  sessions       ActivitySession[]
  adminLogs      AdminLog[]
  preference     Preference?
  tasks          Task[]
}

model Preference {
  id              Int             @id @default(autoincrement())
  userId          Int             @unique
  careerStage     CareerStage
  energyLevel     EnergyLevel
  biggestStruggle String
  tone            Tone
  movementComfort MovementComfort
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id])
}

model Activity {
  id                  Int               @id @default(autoincrement())
  name                String
  type                ActivityType
  description         String
  difficulty          Difficulty        @default(EASY)
  durationMin         Int               @default(3)
  gestureRequirements String?
  status              Status            @default(ACTIVE)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sessions            ActivitySession[]
}

model ActivitySession {
  id          Int          @id @default(autoincrement())
  userId      Int
  activityId  Int
  durationSec Int          @default(0)
  points      Int          @default(0)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  energyLevel EnergyLevel?
  activity    Activity     @relation(fields: [activityId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([activityId])
}

model Achievement {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  description String
  points      Int      @default(0)
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AdminLog {
  id          Int       @id @default(autoincrement())
  adminUserId Int
  action      String
  details     String?
  timestamp   DateTime  @default(now())
  status      LogStatus @default(SUCCESS)
  adminUser   User      @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
}

model Task {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum Role {
  USER
  ADMIN
  LP_STAFF
}

enum ActivityType {
  NOTE_MATCH
  CAKE_CANDLES
  CALMING_FLOW
  ENERGY_BOOST
  GAME
  EXPRESSIVE_PLAY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Tone {
  CALM
  ENERGETIC
  HUMOROUS
  SUPPORTIVE
}

enum MovementComfort {
  LOW
  MEDIUM
  HIGH
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum CareerStage {
  STUDENT
  EARLY_CAREER
  MID_CAREER
  SENIOR
}

enum LogStatus {
  SUCCESS
  FAILURE
}
